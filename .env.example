# =============================================================================
# portfolio_Van_Tho — environment template
# Copy to .env.local and fill REAL values. NEVER commit real secrets.
# Placeholders only in this file. Server-only vars must NOT be prefixed NEXT_PUBLIC_.
# =============================================================================

# --- APP -----------------------------------------------------------------
APP_ENV=development                        # development | preview | production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=vi              # vi | en  (default locale = vi)
ADMIN_ALLOWED_EMAILS=owner@example.com     # comma-separated allow-list (reference, not real data)

# --- NEON (primary application database) ---------------------------------
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require   # pooled runtime connection
DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@HOST/DB?sslmode=require  # migration-only (direct)

# --- SUPABASE (Auth + Storage only) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SECRET   # server-only; NEVER expose to browser

# --- CLOUDFLARE TURNSTILE (bot protection on contact) --------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SECRET  # server-only

# --- EMAIL (optional notification adapter; Neon is the durable source) ---
EMAIL_PROVIDER=disabled                    # disabled | resend | smtp
RESEND_API_KEY=                            # server-only, optional
CONTACT_TO_EMAIL=owner@example.com         # destination reference

# --- OBSERVABILITY (optional) --------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                         # server-only, CI secret
SENTRY_ORG=
SENTRY_PROJECT=
